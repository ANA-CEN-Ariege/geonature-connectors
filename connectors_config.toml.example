# Configuration du module CONNECTORS.
#
# À déposer à côté de geonature_config.toml, sous le nom `connectors_config.toml`.
# Emplacements recherchés, dans l'ordre :
#   1. le chemin donné par la variable d'environnement GEONATURE_CONNECTORS_CONFIG_FILE
#   2. <dossier de geonature_config.toml>/connectors_config.toml
#   3. <racine du module>/config/conf_gn_module.toml
#
# Le fichier est FACULTATIF : sans lui, les valeurs par défaut ci-dessous s'appliquent.
# Toute clé inconnue est refusée au démarrage (schéma Marshmallow strict).

[gbif]
enabled = true

# ── Périmètre ────────────────────────────────────────────────────────────────
# gadm_gid est le seul filtre géographique fiable pour un département français.
# Le résoudre via https://api.gbif.org/v1/geocode/gadm/search?q=<nom>
# Mesuré sur l'Ariège : gadmGid -> 1 309 180 occurrences, stateProvince -> 1 215,
# une bbox lat/lon -> 2 582 085 (elle déborde sur l'Aude et la Catalogne).
gadm_gid = "FRA.11.1_1"
country = "FR"

# ── Qualité de base ──────────────────────────────────────────────────────────
has_coordinate = true
has_geospatial_issue = false
# Ne JAMAIS mettre autre chose que PRESENT sans y avoir réfléchi : les absences
# deviendraient des présences fausses en Synthèse. Un seul jeu ariégeois
# (Culicoides du Cirad) en compte 116 799.
occurrence_status = "PRESENT"

# ── Licences ─────────────────────────────────────────────────────────────────
# Valeurs possibles : "CC0_1_0", "CC_BY_4_0", "CC_BY_NC_4_0".
# Le CC BY-NC est viral : GBIF applique « la plus restrictive gagne », donc une
# seule occurrence non commerciale dans un agrégat le rend non commercial en
# entier. Si vous l'acceptez, versez-le dans un JDD distinct, exclu des exports.
licenses = ["CC0_1_0", "CC_BY_4_0"]

# ── Exclusions ───────────────────────────────────────────────────────────────
# Jeux déjà présents dans votre Synthèse par une autre voie (SINP, saisie directe).
# ⚠ Il n'existe AUCUNE clé permettant de dédoublonner automatiquement contre
# l'existant : cette liste est un travail de curation manuel, irréductible.
exclude_dataset_keys = []
# ⚠ Il n'existe AUCUNE clé permettant de dédoublonner automatiquement contre votre
# Synthèse existante : ni les UUID de jeux de données (GBIF n'expose pas les
# identifiants SINP), ni les identifiants d'observation. Cette liste est un travail
# de curation manuel, irréductible.
#
# Vérifiez vos clés avant de vous y fier : une clé périmée n'exclut rien et ne le
# signale pas. Attention aussi aux jeux homonymes — sur l'Ariège, deux jeux portent
# le titre « Saisie naturaliste opportuniste dans SICEN Occitanie », l'un pour les
# données d'une association, l'autre pour celles d'un autre producteur.

# Exclusion par sous-chaîne du datasetName (insensible à la casse).
# Filet de sécurité complémentaire aux clés, et non redondant : sur une configuration
# réelle en Ariège, les termes rattrapaient 55 919 occurrences réparties sur 4 jeux
# absents de la liste de clés. Les producteurs déclinent leurs jeux en de nombreuses
# entrées GBIF, et une liste de clés se périme.
#
# Un terme court reste utilisable : le sigle « ana » attrapait 13 jeux ariégeois dont
# 12 étaient bien les bons, le seul faux positif étant « Projet CANAlisation gazière ».
# Mesurez avant d'adopter un terme, plutôt que de le supposer sûr ou dangereux.
exclude_dataset_terms = []

# Clés d'organisations publiantes à écarter. Repère : UAR PatriNat publie 75,8 %
# du GBIF ariégeois, données qui proviennent déjà du SINP.
exclude_publishing_orgs = []
# Ne garder que ces observateurs (sous-chaîne sur recordedBy). Vide = tous.
include_observers = []

# Bornes sur eventDate, au format AAAA-MM-JJ. Vides = pas de borne.
date_min = ""
date_max = ""

# ── Précision géographique ───────────────────────────────────────────────────
# Incertitude maximale en mètres. Vide/absent = pas de filtre.
# Repères mesurés sur l'Ariège : <= 1100 m ne retient que 39,9 % des occurrences,
# <= 5000 m en retient 59,7 %. Un seuil trop bas n'écarte pas les mauvaises
# données, il annule l'import : certains jeux publient TOUT à 5 km.
# coordinate_uncertainty_max = 1000

# Sort des occurrences sans incertitude déclarée — 34,9 % du corpus ariégeois.
# Les garder revient à accepter une précision inconnue, potentiellement pire que
# le seuil qu'on rejette par ailleurs.
keep_unknown_uncertainty = true

# ── Jeux publiés à la maille ─────────────────────────────────────────────────
# Écarte les jeux dont les coordonnées sont des centroïdes de maille ou de
# commune plutôt que des points d'observation. La détection croise le machine tag
# GBIF « griddedDataset » (figé depuis 2020, donc incomplet) avec une analyse de
# l'incertitude déclarée sur échantillon. Voir sources/gbif/griddedness.py.
skip_gridded_datasets = true
gridded_threshold_m = 1000

# ── Traçabilité ──────────────────────────────────────────────────────────────
# DOI du téléchargement GBIF, conservé sur chaque observation (obligation de
# citation). L'API `search` n'en délivre aucun : ne vaut que pour l'API
# `download`, et change à chaque téléchargement.
download_doi = ""

# ── Performance ──────────────────────────────────────────────────────────────
# Les triggers de gn_synthese.synthese sont FOR EACH STATEMENT : leur coût ne
# s'amortit qu'en insérant par paquets. Ne pas descendre sous quelques centaines.
batch_size = 1000

# ── Cadre d'acquisition et jeux de données (métadonnées SINP) ────────────────
# Le cadre est créé par la migration du module, qui ne peut pas connaître ces valeurs :
# elles dépendent de l'instance et de la structure qui l'exploite. Le formulaire de
# GeoNature refuse d'enregistrer le cadre et les jeux de données sans elles.
#
# Territoires, EXIGÉS par le formulaire : sans eux, ni le cadre ni les jeux ne peuvent
# être enregistrés. METROP pour la métropole ; une instance ultramarine emploiera GLP,
# MTQ, REU, MYT, GUF, SPM, NCL, PYF…
territoires = ["METROP"]

# Contact principal du cadre (rôle ROLE_ACTEUR 1), lui aussi exigé.
# organisme_contact_principal = "ANA-CEN Ariège"

# Chaque valeur s'écrit en cd_nomenclature OU en libellé, le code primant.
objectifs_cadre = ["Multiples ou autres"]
financement_cadre = "Mixte"
niveau_territorial = "Régional terrestre, ou sous-région marine"


# ── Exclusions taxonomiques ──────────────────────────────────────────────────
# Écarter certains taxons, globalement ou pour un seul jeu de données.
#
# Les `taxon_keys` sont des taxonKey GBIF, **descendants compris** : exclure l'ordre
# Chiroptera (734) écarte aussi bien un Rhinolophus identifié à l'espèce qu'une
# observation restée au genre. Le filtre teste toute la hiérarchie de l'occurrence,
# car GBIF n'offre pas de négation sur `taxonKey` — il est donc appliqué localement,
# après récupération.
#
# Résoudre une clé :
#   https://api.gbif.org/v1/species/match?name=Chiroptera&rank=ORDER   -> usageKey 734
#
# `dataset` accepte indifféremment le datasetKey GBIF ou l'unique_dataset_id du JDD
# GeoNature. Omettre la clé rend l'exclusion globale.

# Exclusion globale — ici, aucune par défaut :
# [[gbif.exclude_taxa]]
# taxon_keys = [734]

# Exclusion restreinte à un jeu de données :
# [[gbif.exclude_taxa]]
# dataset = "1560f099-f48d-43ac-8d88-ce329a53aa7e"   # SICEN Occitanie
# taxon_keys = [734]                                  # chiroptères


# ─────────────────────────────────────────────────────────────────────────────
[gbif.schedule]
# Moissonnage planifié, via le Celery Beat déjà présent dans GeoNature : rien à
# installer ni à configurer au niveau système.
#
# Désactivé par défaut : c'est à l'administrateur de décider qu'un import automatique
# écrive dans sa Synthèse.
enabled = false

# « minute heure jour_du_mois mois jour_de_semaine ». Ici : lundi 3 h du matin.
#
# Une cadence fine ne sert à rien : les producteurs republient rarement. Mesuré sur
# l'Ariège, aucun des 60 plus gros jeux n'avait été modifié dans les 7 derniers jours,
# et la dernière modification de Faune Occitanie remontait à 901 jours. Le connecteur
# saute d'ailleurs les jeux inchangés depuis son dernier passage, si bien qu'une
# semaine sans republication coûte quelques minutes au lieu de plusieurs heures.
crontab = "0 3 * * 1"


[validation]
# Pré-validation automatique des observations importées.
#
# Sans elle, chaque observation prend le défaut de la colonne — « Non évalué », cd 0.
# Sur un import de plusieurs centaines de milliers d'occurrences, cela noierait le module
# Validation sous une file que personne ne traitera, et qui masquerait les observations
# internes réellement à valider.
#
# Deux écritures, et la seconde commande la première :
#   - `gn_commons.t_validations` reçoit une ligne par observation, `validation_auto` à
#     true. C'est ce que lit le module Validation, et ce sur quoi s'appuie son filtre
#     « masquer les validations automatiques » ;
#   - son trigger `tri_insert_synthese_update_validation_status` recopie statut,
#     commentaire et date dans la Synthèse.
# L'historique n'est écrit qu'une fois par observation : un validateur qui tranche
# ensuite a le dernier mot, et le filtre « modifiée depuis sa validation » reste vivant.
#
# `status` accepte un cd_nomenclature du type STATUT_VALID (« 2 ») ou le libellé de
# l'instance (« Probable »), le code primant. Une valeur introuvable fait échouer
# l'import en énumérant les valeurs du référentiel local — elle ne retombe plus en
# silence sur « Non évalué », ce qui rendait ce réglage inopérant.
enabled = false
status = "2"
comment = "Validation automatique — données importées depuis une source externe"

# Les jeux de données créés par les connecteurs entrent-ils dans la file du module
# Validation ? Le module ne liste que les jeux `validable = true`, et c'est le défaut de
# GeoNature. Faux ici : la validation d'une donnée moissonnée appartient à son
# producteur, et la remonter dans la file locale y noierait les données maison.
# Appliqué à chaque import, y compris aux jeux déjà créés.
jdd_validable = false


# ═════════════════════════════════════════════════════════════════════════════
[visionature]
# Connecteur VisioNature (Biolovision). Désactivé par défaut.
enabled = false

# URL de l'instance. Chaque site VisioNature est distinct : ses identifiants OAuth1,
# son référentiel d'espèces et ses identifiants d'observation lui sont propres.
url = "https://www.faune-ariege.fr"

user_email = ""
user_password = ""
# Fournis par Biolovision sur demande, séparément du compte utilisateur.
client_key = ""
client_secret = ""

# Groupes taxonomiques à moissonner, par leur identifiant. Vide = tous ceux que le
# compte peut lire (ceux dont `access_mode` vaut « none » sont écartés d'office).
#
# ⚠ Ces identifiants sont ceux de Faune-Occitanie, relevés le 10/09/2026. Rien ne
#   garantit qu'ils soient les mêmes sur une autre instance : les vérifier avec
#       geonature connectors visionature-groupes
#   qui affiche l'identifiant, le code, l'`access_mode` et la couverture « repro ».
#
# La colonne « repro » ci-dessous indique les groupes pour lesquels le module sait
# déduire un statut de reproduction depuis l'âge, le sexe et les comportements. Les
# oiseaux passent par les codes atlas, pas par ces règles : leur « — » n'est pas un manque.
#
#    id  code                        repro   nom
#     1  TAXO_GROUP_BIRD             —       Oiseaux
#     2  TAXO_GROUP_BAT              oui     Chauves-souris
#     3  TAXO_GROUP_MAMMAL           oui     Mammifères
#     4  TAXO_GROUP_SEA_MAMMAL       —       Mammifères marins
#     6  TAXO_GROUP_REPTILIAN        oui     Reptiles
#     7  TAXO_GROUP_AMPHIBIAN        oui     Amphibiens
#     8  TAXO_GROUP_ODONATA          oui     Odonates
#     9  TAXO_GROUP_BUTTERFLY        oui     Papillons de jour
#    10  TAXO_GROUP_MOTH             —       Papillons de nuit
#    11  TAXO_GROUP_ORTHOPTERA       oui     Orthoptères
#    12  TAXO_GROUP_HYMENOPTERA      —       Hyménoptères
#    14  TAXO_GROUP_ORCHIDACEAE      —       Orchidées
#    15  TAXO_GROUP_TRASH            —       Déchets
#    16  TAXO_GROUP_EPHEMEROPTERA    —       Éphémères
#    17  TAXO_GROUP_PLECOPTERA       —       Plécoptères
#    18  TAXO_GROUP_MANTODEA         —       Mantes
#    19  TAXO_GROUP_AUCHENORRHYNCHA  —       Cigales
#    20  TAXO_GROUP_HETEROPTERA      —       Punaises
#    21  TAXO_GROUP_COLEOPTERA       —       Coléoptères
#    22  TAXO_GROUP_NEVROPTERA       —       Névroptères
#    23  TAXO_GROUP_TRICHOPTERA      —       Trichoptères
#    24  TAXO_GROUP_MECOPTERA        —       Mécoptères
#    25  TAXO_GROUP_DIPTERA          —       Diptères
#    26  TAXO_GROUP_PHASMATODEA      —       Phasmes
#    27  TAXO_GROUP_ARACHNIDA        —       Araignées
#    28  TAXO_GROUP_SCORPIONES       —       Scorpions
#    29  TAXO_GROUP_FISH             —       Poissons
#    30  TAXO_GROUP_MALACOSTRACA     —       Crustacés
#    31  TAXO_GROUP_GASTROPODA       —       Gastéropodes
#    32  TAXO_GROUP_BIVALVIA         —       Bivalves
#    33  TAXO_GROUP_BRANCHIOPODA     —       Branchiopodes
#    43  TAXO_GROUP_DERMAPTERA       —       Dermaptères
#    51  TAXO_GROUP_FORMICIDAE       —       Fourmis
#
# `visionature-volumetrie` chiffre le coût de chacun avant de choisir : sur Faune-Occitanie,
# les oiseaux pèsent 76 % des modifications quotidiennes à eux seuls.
#
#   taxo_groups = ["2", "6", "7"]     # chiroptères, reptiles, amphibiens
taxo_groups = []

# ── Acteurs des jeux de données (métadonnées SINP) ───────────────────────────
# Un jeu de données SANS producteur n'est pas conforme au SINP. Rien dans GeoNature ne
# l'impose techniquement, d'où la facilité avec laquelle on l'oublie.
#
# Les JDD sont découpés par DÉPARTEMENT, parce que c'est là que change le producteur :
# sur Faune-Occitanie, l'Ariège est produite par l'ANA-CEN Ariège, les Pyrénées-
# Orientales par le GOR. Un jeu porte un producteur unique.
#
# ⚠ Les organismes doivent exister dans utilisateurs.bib_organismes, à l'orthographe
#   près. Le module ne les crée jamais : les tirer des données peuplerait le référentiel
#   de variantes que plus personne ne saurait rapprocher.
#
# La structure qui met la donnée à disposition, distincte de celle qui l'a produite.
# organisme_fournisseur = "Collectif Faune-Occitanie"
#
# Contact principal, EXIGÉ par le formulaire de GeoNature. Non renseigné, le fournisseur
# en tient lieu — c'est le cas courant. Un même organisme peut porter plusieurs rôles.
# organisme_contact_principal = "Collectif Faune-Occitanie"
#
# Créer les organismes ci-dessus s'ils n'existent pas encore. Faux par défaut : mieux
# vaut un avertissement qu'une création silencieuse sur une faute de frappe.
# creer_organismes_manquants = true
#
# ── Métadonnées que le jeu prendrait sinon par défaut ─────────────────────────
# Sans ces réglages, l'interface affiche « Financement : Publique » et « Créateur :
# Non renseigné » — le premier vient d'un DEFAULT de colonne dans GeoNature, le second
# de l'absence d'utilisateur courant en ligne de commande. Ni l'un ni l'autre n'a été
# choisi, et « Publique » est probablement faux pour des données associatives.
#
# Nom lisible du portail : les jeux s'appellent alors « Faune Occitanie (Ariège) »
# plutôt que « dép. 09 — www.faune-occitanie.org ». Le nom du département vient de
# ref_geo, qui le porte déjà dans l'orthographe de votre instance.
nom_instance = "Faune Occitanie"

# Territoires du jeu, EXIGÉS par le formulaire de GeoNature : sans eux, le jeu ne peut
# pas être enregistré. METROP pour la métropole ; une instance ultramarine emploiera
# GLP, MTQ, REU, MYT, GUF, SPM, NCL, PYF…
territoires = ["METROP"]

# ── Cadre d'acquisition ──────────────────────────────────────────────────────
# Créé par la migration du module, il en sort sans ces valeurs : elles dépendent de
# l'instance et de la structure qui l'exploite. Le formulaire les exige, ou applique des
# valeurs par défaut que personne n'a choisies.
#
# Chaque valeur s'écrit en cd_nomenclature OU en libellé, le code primant. Le libellé est
# plus lisible mais dépend de la langue et de la version du référentiel.
objectifs_cadre = ["Multiples ou autres"]
financement_cadre = "Mixte"
niveau_territorial = "Régional terrestre, ou sous-région marine"

# cd_nomenclature de DS_PUBLIQUE. Lister les valeurs de votre instance avec :
#   SELECT cd_nomenclature, label_default FROM ref_nomenclatures.t_nomenclatures t
#   JOIN ref_nomenclatures.bib_nomenclatures_types b ON t.id_type = b.id_type
#   WHERE b.mnemonique = 'DS_PUBLIQUE';
# financement = "Pr"
#
# Le financement dépend du PROJET, non du département : la plupart des projets
# VisioNature sont privés, une minorité relève d'un financement public. Ce bloc prime
# sur la valeur ci-dessus, et se place LUI AUSSI à la fin de la section.
#
# [visionature.financement_par_projet]
# "ATLAS-OCC" = "Pu"
#
# Identifiant de connexion ou id_role de l'utilisateur à porter comme créateur.
# createur = "admin"
#
# ⚠ EN TOML, une sous-table avale toutes les clés qui la suivent. Placer le bloc
#   ci-dessous À LA FIN de la section [visionature], jamais au milieu — sinon
#   `pseudonymisation_secret` et les autres réglages basculeraient dedans.
#
# [visionature.producteurs_departementaux]
# "09" = "ANA-CEN Ariège"
# "66" = "GOR"

# ── Confidentialité ──────────────────────────────────────────────────────────
# Clé du HMAC de pseudonymisation. OBLIGATOIRE, même si peu d'observateurs demandent
# l'anonymat : sans elle on ne peut traiter ni ceux qui l'ont demandé, ni ceux que le
# référentiel ne connaît pas. Ne jamais la publier — un pseudonyme dont la clé est
# connue se recalcule, donc se réidentifie.
# Générer avec :  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠ Ne jamais la changer une fois des données importées, et la sauvegarder ailleurs :
# les pseudonymes n'en dérivent que d'elle, et le nom réel n'est pas conservé pour les
# observateurs anonymisés. La remplacer rend `visionature-reanonymiser` aveugle et casse le
# rapprochement des observations d'un même contributeur.
pseudonymisation_secret = ""

# ── Périmètre géographique ───────────────────────────────────────────────────
# Codes de département à conserver. Vérifiés sur `place.county` de chaque relevé, donc
# fiables quoi qu'il arrive. Vide = toute l'étendue de l'instance : sur Faune-Occitanie,
# treize départements. « 9 » et « 09 » sont équivalents.
departements = ["09"]

# Filtre appliqué CÔTÉ SERVEUR, transmis tel quel à l'API. C'est le seul moyen d'éviter
# de télécharger l'instance entière. Lister les valeurs de votre instance avec :
#     geonature connectors visionature-perimetres
# ⚠ Un paramètre inconnu de l'API est ignoré SANS erreur : rien ne distingue un filtre
# appliqué d'un filtre inexistant. D'où la vérification systématique sur `departements`,
# et l'avertissement affiché en fin de moissonnage si le filtre serveur semble ignoré.

# ── Moissonnage complet ──────────────────────────────────────────────────────
# Le moissonnage complet passe par `observations/search`, découpé en tranches de dates
# et borné par territoire. La méthode `list` est dépréciée en amont (Client_API_VN) et
# refusée par l'API ; une recherche SANS périmètre territorial l'est également.
# `departements` est donc OBLIGATOIRE pour un moissonnage complet.
#
# Début de l'historique à moissonner. Vide = 1900-01-01, soit tout l'historique.
# date_debut = "2015-01-01"
#
# Taille de tranche initiale, en jours. Ajustée automatiquement selon le volume rendu :
# réduite si la tranche déborde, élargie si elle est creuse. transfer_vn régule par un
# PID visant 10 000 observations ; on vise la même cible plus simplement.
tranche_jours = 15

# ── Cache des référentiels (mise au point) ───────────────────────────────────
# Un moissonnage commence par trois téléchargements : espèces (63 616 sur
# Faune-Occitanie), groupes taxonomiques, observateurs (246 699). Plusieurs minutes
# avant la première observation traitée. Le cache les évite pendant la mise au point.
#
# 0 = désactivé (défaut). Mettre 24 pour itérer, puis vider :
#     geonature connectors visionature-vider-cache
#
# ⚠ Le référentiel des observateurs contient des NOMS DE PERSONNES. L'activer les écrit
#   sur disque — en 0600, mais en clair — alors que tout le dispositif d'anonymisation
#   vise à ne pas les conserver.
# ⚠ Un référentiel périmé produit des correspondances taxonomiques fausses et des
#   consentements obsolètes, sans rien signaler. Ne pas laisser actif en production.
cache_heures = 0
# cache_dir = "/chemin/vers/un/cache"    # défaut : ~/.cache/gn_module_connectors

# ── Robustesse du client Biolovision ─────────────────────────────────────────
# timeout : secondes avant d'abandonner une requête. À NE PAS mettre à 0 ni retirer —
# le client vendorisé laisse ce paramètre à None s'il n'est pas fourni, et `requests`
# attend alors indéfiniment : un incident réseau fige le moissonnage sans message.
timeout = 120
# Attente après une réponse 503. Le client applique 600 s par défaut, soit jusqu'à une
# demi-heure de gel apparent avec max_retry = 3.
unavailable_delay = 60
max_retry = 3

# Le consentement est individuel : VisioNature porte un champ `anonymous` sur chaque
# observateur, que le module respecte. Passer à true impose le pseudonyme à tous,
# sans consulter le référentiel.
forcer_anonymat = false

# Écarter les observations qu'un modérateur a refusées (admin_hidden_type = "refused").
# Les importer republierait ce qu'un modérateur a explicitement rejeté.
# ⚠ Ne concerne pas les observations masquées (hidden) : voir ci-dessous.
respecter_confidentialite = true

# Niveau de diffusion (cd_nomenclature NIV_PRECIS, ou libellé) des observations masquées
# à la source.
# Dans VisioNature, on masque une observation pour protéger l'espèce ou le site — nid de
# rapace, station d'orchidée, gîte à chiroptères — et non pour la retirer du circuit :
# elle est donc importée, mais marquée non diffusable.
# Référentiel NIV_PRECIS :
#   0 Standard   1 Commune   2 Maille   3 Département   4 Aucune   5 Précise
#   "4" (Aucune) : aucune diffusion. Code employé par GeoNature pour diffusable = false,
#                  et le plus proche du comportement de VisioNature, où une observation
#                  masquée n'apparaît pas publiquement, même dégradée.
#   "2" (Maille) : alimente les cartes de répartition sans livrer la localisation
#                  précise. C'est le choix de gn_vn2synthese, moins restrictif.
# Les observations non masquées gardent un niveau NULL, GeoNature ne calculant plus
# cette colonne : NULL y signifie « le producteur ne se prononce pas ».
# Le libellé est accepté aussi bien que le code — "Aucune" vaut "4" —, et une valeur que
# le référentiel de l'instance ne connaît pas **arrête l'import**. Elle donnait
# auparavant NULL sans un mot, c'est-à-dire aucune restriction, précisément sur les
# observations que ce réglage protège.
niveau_diffusion_masquees = "4"

# ── Jeux de données ──────────────────────────────────────────────────────────
# Un JDD par code projet VisioNature : les projets correspondent à des programmes
# réels (atlas, suivis, plans d'action). À défaut, un JDD unique par instance.
jdd_par_code_projet = true

batch_size = 1000


[visionature.atlas]
# Interprétation des codes atlas de nidification (standard EOAC), surchargeable pour
# un atlas régional qui emploierait ses propres codes.
#
# Seuil à partir duquel un code vaut « Reproduction ». Le code 1 — « vu en période de
# nidification dans un milieu favorable » — n'est pas un indice de reproduction.
reproduction_min = 2

# Code signalant une absence : espèce recherchée, non trouvée. Versé en
# STATUT_OBS = « Non observé », et exclu de la comparaison au seuil — sans quoi 99,
# dépassant le seuil, vaudrait reproduction certaine.
absence = 99

# code atlas -> cd_nomenclature OCC_COMPORTEMENT. Vide = table par défaut du module.
# comportement = { 2 = "18", 5 = "19" }


[visionature.reproduction]
# Statut de reproduction des groupes sans code atlas — amphibiens, reptiles, mammifères,
# chiroptères, odonates, orthoptères, papillons de jour. Déduit de la classe d'âge, du
# sexe et du comportement, dont le sens dépend du groupe taxonomique.
#
# La table de correspondance est livrée avec le module
# (sources/visionature/reproduction.py, transposée de gn_vn2synthese v1.6.0). Cette
# section ne sert qu'à la corriger ou la compléter.
active = true

# Un exemple, et pas au hasard : la table du témoin contient une règle « jeune non velu »
# pour les chiroptères dont le code est NULL, donc qui n'apparie jamais rien. Si votre
# instance emploie ce code, déclarez-le ici.
#
#   [visionature.reproduction.regles.TAXO_GROUP_BAT.age]
#   YOUNGNAKED = "certain"
#
# Le groupe se désigne par son code (TAXO_GROUP_BAT) ou par son identifiant numérique sur
# l'instance ; le type par « age », « sex » ou « behaviour » ; le degré par « certain »,
# « probable », « possible » ou « inconnu ». Seuls les trois premiers valent
# « Reproduction » en Synthèse ; « inconnu » sert à déclarer un code comme examiné et non
# significatif, ce qui l'écarte du signalement de fin de moissonnage.


[visionature.schedule]
enabled = false
crontab = "0 4 * * 1"


# ═══════════════════════════════════════════════════════════════════════════════
# dbChiro
# ═══════════════════════════════════════════════════════════════════════════════

[dbchiro]
# Connecteur dbChiro (dbchiroweb). Désactivé par défaut.
enabled = false

# URL de l'instance.
url = "https://dbchiroc.org"

# ⚠ Compte de service dédié. L'API de dbChiro n'expose aucun jeton : le connecteur se
# connecte par le formulaire Django, et **le périmètre moissonné est celui que ce compte
# voit**. `SightingListPermissionsMixin` filtre le queryset selon ses droits :
#
#   compte `access_all_data`  -> tout, y compris sessions confidentielles, gîtes masqués
#                                et études fermées
#   compte ordinaire, instance réglée SEE_ALL_NON_SENSITIVE_DATA = true
#                             -> toute la donnée non sensible, gîtes masqués exclus
#
# Le second profil est le bon : le tri de sensibilité est alors fait par le serveur, qui
# en est le seul juge légitime, et non par nous après coup.
username = ""
password = ""

# ── Périmètre ─────────────────────────────────────────────────────────────────
# Identifiant de zonage dbChiro, appliqué côté serveur. **Propre à chaque instance** :
# `geonature connectors dbchiro-perimetres` les liste. Ne recopiez pas la valeur d'une autre
# instance. Sur dbchiroc.org, l'Ariège vaut 109 et ramène 8 007 observations sur 8 039.
area = ""

# Codes de département vérifiés sur les zonages de chaque observation reçue. Ce contrôle
# double le filtre serveur à dessein : un paramètre inconnu de l'API DRF est ignoré
# **sans erreur**, et rien ne distinguerait alors un filtre appliqué d'un filtre
# inexistant. Un écart massif est signalé en fin de moissonnage.
departements = ["09"]

# Bornes de date, transmises à l'API (`date_min` / `date_max` portent sur la date
# d'observation, pas sur la date de saisie).
date_min = ""
date_max = ""

# ── Absences ──────────────────────────────────────────────────────────────────
# Les codes `0obs` (« Aucune chauve-souris ou trace ») et `0du` (« Aucun contact
# acoustique ») ne désignent aucun taxon : ils disent qu'on a cherché sans rien trouver.
# 175 observations sur 8 039 dans l'instance mesurée. Écartés par défaut — les importer
# produirait autant de fausses présences, sur des sites où l'espèce a précisément été
# recherchée en vain.
#
# Activé, ils sont versés en STATUT_OBS « Non observé » sur le cd_nom de l'ordre
# Chiroptera, ce qui conserve la trace des prospections négatives au prix de 175 lignes
# « Chiroptera » dans les recherches par taxon.
importer_absences = false

# ── Confidentialité ───────────────────────────────────────────────────────────
# ⚠ dbChiro ne porte **aucun marqueur de consentement par observateur**, contrairement au
# champ `anonymous` de VisioNature. Les 8 039 observations mesurées publient un nom
# complet en clair. Les diffuser suppose donc un accord de l'exploitant portant sur
# l'ensemble des contributeurs, et non le consentement de chacun.
pseudonymiser_observateurs = false
# Obligatoire si la pseudonymisation est active. Aucune valeur par défaut : elle rendrait
# les pseudonymes recalculables par un tiers, donc réidentifiables.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
pseudonymisation_secret = ""

# Niveau de diffusion (cd_nomenclature NIV_PRECIS, ou libellé) appliqué à toutes les
# observations.
#   0 Standard   1 Commune   2 Maille   3 Département   4 Aucune   5 Précise
# Vide = NULL, c'est-à-dire « le producteur ne se prononce pas ». Une valeur inconnue du
# référentiel arrête l'import : elle donnait auparavant NULL en silence, donc aucune
# restriction là où l'exploitant en avait demandé une.
#
# La géométrie reste **exacte en base** dans tous les cas : la flouter serait
# irréversible et ruinerait tout suivi de gîte. La restriction porte sur la diffusion.
# À considérer sérieusement : l'API livre les coordonnées précises de cavités nommées
# (« Trou souffleur - trois frères »), et le référentiel de sensibilité de GeoNature ne
# couvre pas nécessairement tous les sites que l'exploitant juge sensibles.
niveau_diffusion = ""

# ── Cadre d'acquisition et jeu de données (métadonnées SINP) ─────────────────
# Le cadre est créé par la migration du module, qui ne peut pas connaître ces valeurs :
# elles dépendent de l'instance et de la structure qui l'exploite. Le formulaire de
# GeoNature refuse d'enregistrer le cadre et le jeu de données sans elles — comme pour
# [gbif] et [visionature].
#
# Territoires, EXIGÉS par le formulaire. METROP pour la métropole ; une instance
# ultramarine emploiera GLP, MTQ, REU, MYT, GUF, SPM, NCL, PYF…
territoires = ["METROP"]

# Contact principal du cadre (rôle ROLE_ACTEUR 1), lui aussi exigé.
# organisme_contact_principal = "ANA-CEN Ariège"

# Chaque valeur s'écrit en cd_nomenclature OU en libellé, le code primant.
objectifs_cadre = ["Multiples ou autres"]
financement_cadre = "Mixte"
niveau_territorial = "Régional terrestre, ou sous-région marine"

# ── Moissonnage ───────────────────────────────────────────────────────────────
# Plafonné à 5000 par la pagination de dbChiro. À 8 039 observations, deux pages.
page_size = 5000
timeout = 120
batch_size = 1000

[dbchiro.schedule]
enabled = false
crontab = "0 5 * * 1"


# ═══════════════════════════════════════════════════════════════════════════════
# GeoNature — moissonnage d'une AUTRE instance GeoNature
# ═══════════════════════════════════════════════════════════════════════════════
#
# La source est l'API du **module d'export** du GeoNature distant, pas celle de sa
# Synthèse. Le choix n'est pas de commodité : `POST /synthese/export_observations` rend un
# fichier, sans `limit` ni `offset`, et sa requête est plafonnée en dur par
# `NB_MAX_OBS_EXPORT` (50 000 par défaut). Au-delà, la donnée est tronquée sans que rien ne
# le dise. L'API d'export, elle, pagine réellement et filtre côté serveur.
#
# Ce que l'instance distante doit avoir :
#   - `gn_module_export` installé ;
#   - un export déclaré sur `gn_exports.v_synthese_sinp` (la vue fournie avec le module) ;
#   - un jeton pour cet export, ou l'export marqué « public ».
#
# ⚠ Ce connecteur reprend **les identifiants SINP du producteur** : l'`unique_id_sinp` de
# chaque observation, l'`unique_dataset_id` de chaque jeu, l'UUID de chaque cadre
# d'acquisition. C'est ce que dit le SINP — un jeu garde son identité d'une plateforme à
# l'autre — et cela a deux conséquences qu'il faut avoir en tête avant d'importer :
#   - un jeu de données déjà présent localement sous le même UUID sera **alimenté**, pas
#     dupliqué. Ses métadonnées ne seront pas réécrites (voir mettre_a_jour_jdd_existants) ;
#   - une observation déjà en base sous une autre source (le GBIF republie les données
#     GeoNature françaises avec leur UUID SINP) entre en collision. Voir
#     sur_conflit_autre_source.
#
# Lancez `geonature connectors geonature-couverture` avant tout import : la commande
# n'écrit rien et montre l'écart de version TAXREF, les cd_nom non résolus, les collisions
# d'UUID, les jeux déjà présents et les libellés de nomenclature non reconnus.
[geonature]
enabled = false

# URL de l'instance distante, sans barre oblique finale.
url = ""

# ⚠ Identifiant **propre à l'instance distante**, que seul son administrateur peut donner :
# la route qui liste les exports exige un compte et une permission, là où le jeton n'ouvre
# que l'export auquel il se rapporte. Il n'existe donc aucune commande pour le découvrir.
id_export = 0

# Jeton de l'export, transmis dans l'en-tête HTTP `api-key` — jamais en chaîne de requête,
# où il finirait en clair dans les journaux du serveur distant et de tout proxy.
jeton = ""

# ── Périmètre ─────────────────────────────────────────────────────────────────
# WKT en 4326, appliqué côté serveur. Une **enveloppe** suffit : cinq points au lieu de
# milliers, une URL qui reste courte, et la sur-sélection est rattrapée par la bbox
# ci-dessous. `geonature-import --perimetre 09` la calcule depuis le ref_geo local.
perimetre_wkt = ""

# Emprise (ouest, sud, est, nord) vérifiée sur chaque observation. Double le filtre
# serveur, pour la raison qui vaut partout ici : un paramètre inconnu de l'API est ignoré
# **sans erreur**. Le diagnostic est meilleur que pour les autres connecteurs — un
# `total_filtered` égal à `total` trahit un filtre ignoré dès la première page — mais ce
# second rideau reste utile si l'emprise serveur est plus large que l'emprise voulue.
bbox = []

# Liste blanche d'`unique_dataset_id` distants. Souvent le vrai besoin : « je veux ce
# jeu-là de cette instance », et non tout son corpus.
jdd_uuids = []

# Filtres bruts transmis tels quels à l'API d'export. Conventions du module :
#   <col>=val   ilike<col>=val   filter_d_up_<col>=date   filter_n_up_<col>=nombre
filtre_api = {}

# ── Incrémental ───────────────────────────────────────────────────────────────
# Recul appliqué au filigrane du dernier passage. Les horloges des deux instances
# diffèrent et un import long chevauche la borne : sans marge, les lignes modifiées
# pendant le passage précédent seraient perdues **définitivement**, le filigrane montant
# quand même.
#
# ⚠ L'import fait deux passes de date, sur `date_modification` et sur `date_creation`.
# La première est `meta_update_date`, NULL tant que la ligne n'a jamais été modifiée :
# s'y fier seule ferait manquer toutes les créations.
marge_heures = 24

# ── Conflits d'identifiants ───────────────────────────────────────────────────
# ⚠ À lire avant de changer la valeur.
#
# Ce connecteur reprend l'unique_id_sinp du producteur. Le connecteur GBIF fait de même
# quand l'occurrenceID contient un UUID — ce qui est le cas de 100 % des jeux publiés par
# PatriNat, soit 75,8 % du corpus GBIF ariégeois (docs/gbif-ariege.md), et couvre
# précisément ce qu'une instance partenaire détient aussi : Faune Occitanie, SICEN, ANA,
# LIFE Desman, Natura 2000. Les collisions se comptent donc par milliers.
#
# ⚠ **Le conflit ne se règle pas ici.** `INSERT_SQL` ne réécrit jamais id_source — la
# colonne reste au premier connecteur qui a inséré la ligne — mais il écrase tout le
# contenu. Deux connecteurs qui moissonnent la même observation se réécrivent donc l'un
# l'autre à chaque exécution, indéfiniment, et le conflit devient invisible puisque
# l'id_source ne les distingue plus.
#
# Le seul vrai remède est en amont : **une observation ne doit être moissonnée que par un
# seul connecteur.** Écartez les jeux que ce GeoNature publie déjà, côté GBIF, par
# [gbif] exclude_dataset_keys — la liste couvre déjà Faune Occitanie, Faune France,
# SICEN, ANA, LIFE Desman, Natura 2000, PRA.
#
#   « ignorer »   la ligne distante est écartée et tracée dans geonature_rejets.csv.
#                 Seule option **stable** : le connecteur n'écrit pas, rien n'oscille.
#                 Le prix est de conserver la copie du GBIF, qui a pu perdre en précision
#                 géographique et en nomenclatures lors de la republication.
#   « remplacer » la ligne concurrente est supprimée, puis remplacée par la nôtre, plus
#                 fidèle. ⚠ N'a de sens que si l'autre connecteur cesse de moissonner ces
#                 observations : sinon il les reprend au passage suivant et le conflit
#                 devient indétectable. L'import avertit quand [gbif] enabled est vrai.
sur_conflit_autre_source = "ignorer"

# Rafraîchir nom et description d'un jeu déjà présent localement sous le même UUID.
# Faux par défaut : le jeu local a pu être enrichi à la main, et le nom que l'API nous
# donne n'est pas forcément meilleur que celui qui s'y trouve.
mettre_a_jour_jdd_existants = false

# ── Confidentialité ───────────────────────────────────────────────────────────
# ⚠ Faux par défaut, contrairement à [dbchiro], et pour une raison de fond : une instance
# GeoNature est un producteur SINP conforme, qui a déjà arbitré ce qu'il diffuse. L'export
# existe parce qu'un administrateur l'a créé, et chaque observation porte son niveau de
# sensibilité et de diffusion. Refaire cet arbitrage ici substituerait notre jugement au
# sien. L'option reste offerte pour les conventions de partage qui interdisent la
# republication des noms.
pseudonymiser_observateurs = false
pseudonymisation_secret = ""

# cd_nomenclature ou libellé NIV_PRECIS imposé à TOUTES les observations.
#   0 Standard   1 Commune   2 Maille   3 Département   4 Aucune   5 Précise
# Une valeur inconnue du référentiel arrête l'import, et le fait désormais au démarrage,
# avant le premier appel à l'instance distante.
# Vide = on reprend le `precision_diffusion` du producteur, ce qui vaut mieux : son
# arbitrage est porté par la donnée, observation par observation.
niveau_diffusion = ""

# ⚠ Restriction appliquée aux seules observations que le producteur déclare sensibles.
# Parade au décalage des référentiels : `id_nomenclature_sensitivity` est recalculée
# localement par le trigger de la Synthèse, et si notre référentiel de sensibilité couvre
# moins d'espèces que celui du distant, la donnée serait **moins protégée ici qu'à la
# source**. Renseigner « 2 » (maille) ou « 3 » (département) rétablit une protection.
niveau_diffusion_si_sensible = ""

# Licences acceptées, par leur nom tel que l'export le déclare. Vide = tout accepter.
# L'import refuse de tourner si la licence de l'export n'y figure pas.
licences_acceptees = []

# ── Métadonnées SINP des cadres et jeux créés ─────────────────────────────────
# Le formulaire de GeoNature exige un territoire et un contact principal : sans eux, ni le
# cadre ni le jeu ne peuvent être enregistrés depuis l'interface, et rien ne le signale
# tant qu'on ne les ouvre pas.
territoires = ["METROP"]
# Nom exact d'un organisme de utilisateurs.bib_organismes. ⚠ Le module ne CRÉE jamais
# d'organisme à partir des données d'une API : les producteurs cités par l'export sont
# rapprochés s'ils existent, et signalés sinon.
organisme_contact_principal = ""
objectifs_cadre = []
financement_cadre = ""
niveau_territorial = ""

# ── Réconciliation ────────────────────────────────────────────────────────────
# `geonature-reconcilier` répercute les suppressions faites à la source : l'API d'export ne
# publie aucun journal, on relit donc tout et ce qui n'est pas revenu a disparu. Elle
# simule par défaut et exige --yes.
#
# Part maximale du corpus supprimable en une fois, en pourcentage (minimum 100 lignes).
# Au-delà, elle refuse : un producteur qui republierait sous de nouveaux identifiants
# ferait sinon tout disparaître d'un coup.
plafond_suppressions = 5

# ── Moissonnage ───────────────────────────────────────────────────────────────
# `max_page_size_api` vaut 1000 côté serveur et rabote sans le dire. La valeur réellement
# appliquée est relue sur la première page.
page_size = 1000
timeout = 120
batch_size = 1000

# ⚠ Comme [visionature.schedule] et [dbchiro.schedule], cette section est lue par le
# schéma de configuration mais **pas encore câblée** dans tasks.py, qui n'ordonnance que
# GBIF. Planifier l'import passe pour l'instant par cron.
[geonature.schedule]
enabled = false
crontab = "0 4 * * 1"
